     GetCurrentThread()->Priority = NewPriority;
+}*/
+
+void
+ThreadSetPriority(
+    IN      THREAD_PRIORITY     NewPriority
+    )
+{
+    INTR_STATE oldState;
+    PTHREAD pCurrentThread;
+    PLIST_ENTRY pEntry;
+    PTHREAD pHeadReadyThread;
+    BOOLEAN mustYield;
+
+    pEntry = NULL;
+    mustYield = FALSE;
+
+    ASSERT(ThreadPriorityLowest <= NewPriority && NewPriority <= ThreadPriorityMaximum);
+
+    LockAcquire(&m_threadSystemData.ReadyThreadsLock, &oldState);
+
+    pCurrentThread = GetCurrentThread();
+    ASSERT(NULL != pCurrentThread);
+
+    pCurrentThread->Priority = NewPriority;
+
+    if(!IsListEmpty(&m_threadSystemData.ReadyThreadsList))
+    {
+        pEntry = m_threadSystemData.ReadyThreadsList.Flink;
+        ASSERT(NULL != pEntry);
+
+        pHeadReadyThread = CONTAINING_RECORD(pEntry, THREAD, ReadyList);
+        ASSERT(NULL != pHeadReadyThread);
+
+        if(ThreadGetPriority(pHeadReadyThread) > pCurrentThread->Priority)
+        {
+            mustYield = TRUE;
+        }
+    }
+
+    LockRelease(&m_threadSystemData.ReadyThreadsLock, oldState);
+
+    if(mustYield == TRUE)
+    {
+        ThreadYield();
+    }
 }
 
 STATUS
@@ -1276,4 +1382,30 @@ _ThreadKernelFunction(
 
     ThreadExit(exitStatus);
     NOT_REACHED;
+}
+
+INT64
+ThreadComparePriorityReadyList(
+    IN      PLIST_ENTRY         FirstElement,
+    IN      PLIST_ENTRY         SecondElement,
+    IN_OPT  PVOID               Context               
+    )
+{
+    PTHREAD pTh1;
+    PTHREAD pTh2;
+    THREAD_PRIORITY firstThreadPriority;
+    THREAD_PRIORITY secondThreadPriority;
+
+    UNREFERENCED_PARAMETER(Context);
+
+    ASSERT(NULL != FirstElement);
+    ASSERT(NULL != SecondElement);
+
+    pTh1 = CONTAINING_RECORD(FirstElement, THREAD, ReadyList);
+    firstThreadPriority = ThreadGetPriority(pTh1);
+
+    pTh2 = CONTAINING_RECORD(SecondElement, THREAD, ReadyList);
+    secondThreadPriority = ThreadGetPriority(pTh2);
+
+    return (INT64)secondThreadPriority - (INT64)firstThreadPriority;
 }
